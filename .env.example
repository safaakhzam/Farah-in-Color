# ─────────────────────────────────────────────────────────────
# Farah in Color – environment variables
# Copy this file to `.env.local` for local development and add
# the same keys in Vercel → Project → Settings → Environment Variables.
# Leave Supabase keys empty to run the site in DEMO MODE (sample paintings,
# nothing is saved).
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO, sitemap and links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=

# Resend (https://resend.com) for emails
RESEND_API_KEY=
# Must be on a domain you verified in Resend, e.g. "Farah in Color <orders@farahincolor.com>"
EMAIL_FROM="Farah in Color <onboarding@resend.dev>"
# Where new orders / commissions / messages are sent (can also be set in Admin → Settings)
ARTIST_NOTIFICATION_EMAIL=

# WhatsApp number in international format, digits only (e.g. 9613123456)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Instagram feed (optional). Long-lived token from the Instagram API with Instagram Login.
INSTAGRAM_ACCESS_TOKEN=

# Secret used by the monthly Vercel Cron job that refreshes the Instagram token
CRON_SECRET=
